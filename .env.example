# Copy to .env — never commit real secrets. Separate keys per environment.

# ---- Shared ----
NODE_ENV=development

# ---- apps/api (Dev B) ----
API_PORT=4000
# memory = in-memory store seeded from assets/seed (offline demo, default)
# postgres = Drizzle + Postgres from docker-compose
DATA_DRIVER=memory
DATABASE_URL=postgres://gsc:gsc@localhost:5432/gsc
REDIS_URL=redis://localhost:6379
# mock | anthropic   (LLM behind an interface)
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=claude-sonnet-5-5
# mock | whatsapp
MESSAGING_CHANNEL=mock
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
# mock | webhook
CRM_ADAPTER=mock
CRM_WEBHOOK_URL=
QUIET_HOURS=22:00-08:00
TIMEZONE=Asia/Dubai

# ---- apps/web + apps/dashboard ----
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_DEFAULT_PROJECT_ID=prj_azure_crest
