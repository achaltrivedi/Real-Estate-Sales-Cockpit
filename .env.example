# Copy to .env — never commit real secrets. Separate keys per environment.

# ---- Shared ----
NODE_ENV=development

# ---- apps/api (Dev B) ----
API_PORT=4000
# fatal | error | warn | info | debug | trace | silent   (default: info; silent under tests)
LOG_LEVEL=info
# Comma-separated browser origins allowed to call the API, or "*".
# Empty = any origin outside production, none in production. Set it for previews/prod.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
# memory = in-memory store seeded from assets/seed (offline demo, default)
# postgres = Drizzle + Postgres (docker-compose locally, Supabase when deployed). One-time setup:
#   pnpm db:up && pnpm --filter @gsc/db migrate && pnpm --filter @gsc/db seed
# Supabase: Project Settings > Database > Connection string > "Session pooler", append ?sslmode=require
DATA_DRIVER=memory
DATABASE_URL=postgres://gsc:gsc@localhost:5432/gsc
# mock | openai   (mock = offline rules, free; openai = structured-output slot extraction, falls back to rules)
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# mock | whatsapp
MESSAGING_CHANNEL=mock
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
# Meta app secret: when set, inbound webhooks must carry a valid X-Hub-Signature-256 (set it in production)
WHATSAPP_APP_SECRET=
# Project that new WhatsApp leads belong to; country code for local numbers like 050...
DEFAULT_PROJECT_ID=prj_azure_crest
DEFAULT_COUNTRY_CODE=971
# mock | webhook
CRM_ADAPTER=mock
CRM_WEBHOOK_URL=
# Follow-up reminders after the buyer's last message (max 3; e.g. 2m,10m for a live demo)
FOLLOW_UP_DELAYS=1h,24h,72h
SCHEDULER_POLL_SECONDS=15
QUIET_HOURS=22:00-08:00
TIMEZONE=Asia/Dubai

# ---- apps/web + apps/dashboard ----
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_DEFAULT_PROJECT_ID=prj_azure_crest
